# Netlify _headers — security response headers for all routes.
# Validated by scripts/check-security.js (npm run check:security).
#
# Five required headers:
#   Content-Security-Policy
#   X-Frame-Options
#   X-Content-Type-Options
#   Referrer-Policy
#   Permissions-Policy

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
